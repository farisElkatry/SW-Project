        </mxCell>
        <mxCell id="c42" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=4;fontSize=10.5;fontColor=#1F2D3D;fillColor=#FFF8E1;strokeColor=#D4A72C;strokeWidth=1.2;" value="&lt;b&gt;Steps 7–10 · two movements&lt;/b&gt;&lt;br&gt;One OUT movement for the source and one IN movement for the destination, each stamped with user and time (FR-INV-02, NFR-SEC-05)." vertex="1">
