        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor BM as Branch Manager\n    participant UI as Forecast UI\n    participant SVC as Forecast Service\n    participant DB as DB\n    participant GEM as Gemini API\n\n    BM-&gt;&gt;UI: Request demand forecast\n    UI-&gt;&gt;SVC: getForecast(branch, product)\n\n    SVC-&gt;&gt;DB: Get current month sales stats\n    DB--&gt;&gt;SVC: Current month stats\n\n    SVC-&gt;&gt;GEM: Summarize current month (System Prompt A + stats)\n    GEM--&gt;&gt;SVC: Current month summary\n\n    SVC-&gt;&gt;DB: Save current month summary\n    SVC-&gt;&gt;DB: Get monthly summaries (last 12 months, or all available)\n    DB--&gt;&gt;SVC: Past monthly summaries\n\n    SVC-&gt;&gt;GEM: Forecast next month (System Prompt B + past summaries + current month)\n\n    alt Gemini returned a forecast\n        GEM--&gt;&gt;SVC: Next month forecast + trend explanation\n        SVC--&gt;&gt;UI: Forecast + explanation\n        UI--&gt;&gt;BM: Show forecast\n    else Gemini unavailable or timeout\n        SVC--&gt;&gt;UI: Calculated numbers + no recommendation available\n        UI--&gt;&gt;BM: Show numbers and notice\n    end\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="4sGXn2BmlkgriEOV7hWI-2">
